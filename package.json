{
  "name": "mizuki-bot",
  "version": "1.0.0",
  "description": "Mizuki — WhatsApp community bot with AI, admin, media, and minigame commands",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "migrate": "tsc && node dist/data/migrate.js",
    "test": "npm run build && node --test tests/core.test.js",
    "audit": "npm audit"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@whiskeysockets/baileys": "^6.7.16",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "mysql2": "^3.11.5",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
