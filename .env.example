# Mizuki WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in the values.

# --- Google Gemini (AI) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=mizuki
DB_PASSWORD=your_db_password_here
DB_NAME=mizuki_bot

# --- MySQL Backup ---
# XAMPP example. Leave empty when mysql/mysqldump are already in PATH.
MYSQL_BIN_DIR=C:\xampp\mysql\bin
# Backup location relative to the project and automatic retention period.
DB_BACKUP_DIR=backups
DB_BACKUP_RETENTION_DAYS=30

# --- Bot Configuration ---
# Command prefix
BOT_PREFIX=!m

# Optional path to Mizuki's dedicated persona file
PERSONALITY_FILE=personality.md

# Fallback used only when the personality file cannot be found
# BOT_PERSONA="You are Mizuki, a friendly and helpful WhatsApp community assistant."

# Number of past exchanges to keep in AI memory per user (1 exchange = 1 user msg + 1 assistant msg)
MEMORY_WINDOW=5

# Per-user AI protection: 5 requests in each 3-minute window
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_SECONDS=180
AI_MAX_INPUT_CHARACTERS=4000

# Media protection: 3 conversions per user in each 5-minute window
MEDIA_RATE_LIMIT_MAX=3
MEDIA_RATE_LIMIT_WINDOW_SECONDS=300
MEDIA_MAX_CONCURRENT=2
MEDIA_MAX_QUEUE=8
# WhatsApp animated sticker output limit
ANIMATED_STICKER_MAX_SIZE_KB=500

# Name shown in WhatsApp sticker information
STICKER_PACK_ID=com.mizuki.bot
STICKER_PACK_NAME=Mizuki
STICKER_AUTHOR=Mizuki Bot

# Remove command/admin audit rows older than this many days
LOG_RETENTION_DAYS=90

# --- Owner Information ---
OWNER_NAME=Mizuki Owner
# International format without a leading +, for example: 60123456789
OWNER_NUMBER=60123456789

# --- Logging ---
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
