# Mizuki WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in the values.

# --- Google Gemini (AI) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- OpenRouter free fallback (used automatically when Gemini fails) ---
# Create a key at https://openrouter.ai/keys. The default router only selects free models.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# --- PostgreSQL Database ---
# Recommended for local use and required by most 24/7 hosting providers.
DATABASE_URL=postgresql://mizuki:your_db_password_here@localhost:5432/mizuki_bot
# If DATABASE_URL is blank, Mizuki uses the standard PGHOST/PGPORT/PGUSER/
# PGPASSWORD/PGDATABASE variables instead.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=mizuki
# PGPASSWORD=your_db_password_here
# PGDATABASE=mizuki_bot
# Enable only when your PostgreSQL provider requires TLS but its URL has no sslmode.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- PostgreSQL Backup ---
# Leave blank when pg_dump and psql are already in PATH.
# Windows example: C:\Program Files\PostgreSQL\18\bin
POSTGRES_BIN_DIR=
# Backup location relative to the project and automatic retention period.
DB_BACKUP_DIR=backups
DB_BACKUP_RETENTION_DAYS=30

# --- Bot Configuration ---
# Command prefix (usage: !m help — the space is required)
BOT_PREFIX=!m

# Number of past exchanges to keep in AI memory per user (1 exchange = 1 user msg + 1 assistant msg)
MEMORY_WINDOW=5

# Per-user AI protection: 5 requests in each 3-minute window
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_SECONDS=180
# Stop unusually slow provider requests. Input and output text have no app-level cap.
AI_TIMEOUT_MS=60000

# Media conversions have no per-user usage limit. Process one at a time;
# later requests wait in the bounded queue to protect CPU and memory.
MEDIA_QUEUE_ENABLED=true
MEDIA_MAX_CONCURRENT=1
MEDIA_MAX_QUEUE=8
# 0 = FFmpeg automatically uses available CPU threads; e.g. 2 limits CPU use.
FFMPEG_THREADS=0
# HD Status input/output guards
STATUS_MAX_FILE_SIZE_MB=64
STATUS_MAX_DURATION_SECONDS=300
STATUS_PROCESSING_TIMEOUT_SECONDS=300
# WhatsApp animated sticker output limit
ANIMATED_STICKER_MAX_SIZE_KB=500
# Smoothness: 30 is smoothest; use 24 for a size/quality balance.
ANIMATED_STICKER_FPS=30
# WebP compression 0-6: lower is faster, higher is slower but usually smaller.
ANIMATED_STICKER_COMPRESSION_LEVEL=4

# Public YouTube video and TikTok/Instagram/X post downloads
# (yt-dlp + gallery-dl + ffmpeg required)
YT_DLP_PATH=yt-dlp
GALLERY_DL_PATH=gallery-dl
# Optional: opera, chrome, edge, firefox, etc. Leave blank unless TikTok/Instagram/X requires login.
# Use a dedicated browser profile/account; this grants the bot access to that browser session.
GALLERY_DL_COOKIES_BROWSER=
# Optional free-tier fallback used only when TikTok blocks local extractors.
# Create a free key at https://www.socialkit.dev/ and never commit the real key.
SOCIALKIT_API_KEY=
# Free no-key fallback used after SocialKit fails or its credits run out.
TIKWM_FALLBACK_ENABLED=true
# Random pause between completed social downloads (0 disables the pause).
DOWNLOAD_DELAY_MIN_SECONDS=5
DOWNLOAD_DELAY_MAX_SECONDS=10
DOWNLOAD_MAX_SIZE_MB=64
DOWNLOAD_MAX_TOTAL_SIZE_MB=128
DOWNLOAD_MAX_ITEMS=10
DOWNLOAD_MAX_DURATION_SECONDS=900
# Overall deadline for one social-download command, including every fallback.
DOWNLOAD_TIMEOUT_MS=180000

# Name shown in WhatsApp sticker information
STICKER_PACK_ID=com.mizuki.bot
STICKER_PACK_NAME=Mizuki
STICKER_AUTHOR=Mizuki Bot

# Remove command/admin audit rows older than this many days
LOG_RETENTION_DAYS=90

# --- Owner Information ---
OWNER_NAME=Mizuki Owner
# International format without a leading +, for example: 60123456789
OWNER_NUMBER=60123456789

# --- Logging ---
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
